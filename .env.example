# ============================================
# OFARO TECH - Variables d'Environnement
# ============================================
# 
# Ce fichier contient des exemples de variables d'environnement.
# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs.
#
# IMPORTANT : 
# - Ne commitez JAMAIS .env.local sur GitHub
# - Sur Vercel, ajoutez ces variables dans Settings > Environment Variables
#

# ============================================
# SITE CONFIGURATION
# ============================================

# URL de base du site (en production)
NEXT_PUBLIC_SITE_URL=https://ofarotech.com

# Email de contact par défaut
NEXT_PUBLIC_CONTACT_EMAIL=contact@ofarotech.com

# Téléphone de contact
NEXT_PUBLIC_CONTACT_PHONE=+228XXXXXXXX


# ============================================
# ANALYTICS & MONITORING (Optionnel)
# ============================================

# Google Analytics Measurement ID
# Obtenir sur : https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager ID (optionnel)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel (Facebook) - Optionnel
NEXT_PUBLIC_META_PIXEL_ID=


# ============================================
# SERVICES TIERS (Optionnel)
# ============================================

# SendGrid API Key (pour l'envoi d'emails)
# Obtenir sur : https://sendgrid.com
SENDGRID_API_KEY=

# Resend API Key (alternative à SendGrid)
# Obtenir sur : https://resend.com
RESEND_API_KEY=

# Mailgun API Key (alternative)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=


# ============================================
# CMS / BASE DE DONNÉES (Futur)
# ============================================

# Contentful (CMS Headless) - Optionnel
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Sanity (CMS) - Optionnel
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Base de données (si backend ajouté plus tard)
DATABASE_URL=


# ============================================
# AUTHENTIFICATION (Futur Admin)
# ============================================

# NextAuth Secret (pour admin dashboard futur)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://ofarotech.com


# ============================================
# SERVICES TIERS ADDITIONNELS
# ============================================

# Google Maps API (pour la carte de contact)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# reCAPTCHA v3 (protection anti-spam formulaires)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Stripe (pour paiements futurs)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# WhatsApp Business API (optionnel)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=


# ============================================
# ENVIRONNEMENT
# ============================================

# Mode de l'application (development, production)
NODE_ENV=production

# Port du serveur (développement uniquement)
PORT=3000
