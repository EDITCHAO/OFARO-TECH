# OFARO TECH - Configuration Environnement

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ofaro_tech
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret (générer une clé forte pour la production)
JWT_SECRET=change_this_secret_key_in_production_use_long_random_string

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upload de fichiers
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./public/uploads

# Email (SMTP pour notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ofaro.tech@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=OFARO TECH <ofaro.tech@gmail.com>

# 2FA (Two Factor Authentication)
TWO_FACTOR_ISSUER=OFARO TECH

# Session
SESSION_SECRET=change_this_session_secret_key_in_production

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Analytics (optionnel)
GOOGLE_ANALYTICS_ID=
PLAUSIBLE_DOMAIN=

# Production
NODE_ENV=development
